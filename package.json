{
  "name": "@philomelcc/dsh-interaction",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH 交互增强：分支式提问 + 跨会话唤醒 + 文件支持扩展（音频/图片预览），三块能力都能在设置里单独开关。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-relay": "bin/relay.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ask-user",
    "question",
    "cross-session",
    "agent",
    "document-preview",
    "audio",
    "image"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philomelcc/dsh-interaction.git"
  },
  "homepage": "https://github.com/philomelcc/dsh-interaction#readme",
  "bugs": {
    "url": "https://github.com/philomelcc/dsh-interaction/issues"
  },
  "author": "philomelcc",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
